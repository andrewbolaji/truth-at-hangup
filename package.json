{
  "name": "truth-at-hangup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "demo": "npm run build && npm run start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "run:eval": "tsx src/harness/cli.ts run",
    "judge": "tsx src/harness/cli.ts judge",
    "rescore": "tsx src/harness/cli.ts rescore",
    "verify:replay": "tsx src/harness/cli.ts verify-replay"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
